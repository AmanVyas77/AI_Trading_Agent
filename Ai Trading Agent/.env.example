# ============================================================
# Quant Finance Research Platform — Environment Variables
# Copy this to .env and fill in your values. Never commit .env.
# ============================================================

# FRED API (free at https://fred.stlouisfed.org/docs/api/api_key.html)
FRED_API_KEY=your_fred_api_key_here

# SEC EDGAR (no key needed for public API, but set user-agent per their policy)
SEC_USER_AGENT="YourName your@email.com"

# Simfin (free tier at https://simfin.com)
SIMFIN_API_KEY=your_simfin_api_key_here

# Seeking Alpha / transcript source (update when access confirmed)
# SEEKING_ALPHA_API_KEY=

# Optional: Polygon.io (future premium data upgrade)
# POLYGON_API_KEY=

# Database
DB_PATH=data/quant_research.db
